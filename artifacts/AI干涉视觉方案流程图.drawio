<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="24.16.0">
  <diagram name="视觉方案流程">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AI 干涉实验视觉方案流程图" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#0B5CAD;" vertex="1" parent="1"><mxGeometry x="360" y="20" width="900" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="近场条纹识别 · 零级中心精定位 · 微分表视觉读数 · 安全闭环控制" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#52606D;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="900" height="30" as="geometry"/></mxCell>

        <mxCell id="acq" value="① 图像采集与统一设备所有权" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#EAF3FF;strokeColor=#1677FF;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="330" height="800" as="geometry"/></mxCell>
        <mxCell id="vision" value="② 干涉图像识别与中心定位" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#F5F9FF;strokeColor=#1677FF;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="780" height="800" as="geometry"/></mxCell>
        <mxCell id="out" value="③ 控制、测量与实时输出" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;html=1;fontStyle=1;fontSize=15;fillColor=#F2FBF8;strokeColor=#00A67E;" vertex="1" parent="1"><mxGeometry x="1210" y="120" width="390" height="800" as="geometry"/></mxCell>

        <mxCell id="start" value="启动视觉模块" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="acq"><mxGeometry x="85" y="55" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="registry" value="双相机注册表&#xa;申请独占设备租约" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="acq"><mxGeometry x="65" y="145" width="190" height="65" as="geometry"/></mxCell>
        <mxCell id="camera_ok" value="目标相机可用且&#xa;未被其他任务占用？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="acq"><mxGeometry x="65" y="245" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="occupied" value="拒绝重复打开&#xa;提示选择其他设备" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="acq"><mxGeometry x="20" y="385" width="130" height="65" as="geometry"/></mxCell>
        <mxCell id="capture" value="干涉相机采集&#xa;1280 × 1024 彩色帧" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="acq"><mxGeometry x="170" y="385" width="140" height="65" as="geometry"/></mxCell>
        <mxCell id="correct" value="画面校正与增强&#xa;旋转 / 缩放 / 平移&#xa;运动清晰度增强" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="acq"><mxGeometry x="165" y="490" width="150" height="85" as="geometry"/></mxCell>
        <mxCell id="roi" value="人工 ROI 已设置？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="acq"><mxGeometry x="165" y="615" width="150" height="85" as="geometry"/></mxCell>
        <mxCell id="crop" value="裁剪 ROI&#xa;坐标保留全帧映射" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="acq"><mxGeometry x="165" y="735" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="full" value="使用完整校正帧" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="acq"><mxGeometry x="15" y="735" width="125" height="60" as="geometry"/></mxCell>

        <mxCell id="yolo" value="条纹目标检测&#xa;YOLO 实时推理&#xa;置信度筛选 + IoU + NMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E1F2;strokeColor=#76539B;fontStyle=1;strokeWidth=2;shadow=1;" vertex="1" parent="vision"><mxGeometry x="280" y="55" width="220" height="85" as="geometry"/></mxCell>
        <mxCell id="detected" value="识别结果？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4D6;strokeColor=#D6A53A;fontStyle=1;strokeWidth=2;" vertex="1" parent="vision"><mxGeometry x="295" y="180" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="near" value="near_fringe&#xa;近场彩色条纹" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3EFFF;strokeColor=#1677FF;fontStyle=1;strokeWidth=2;shadow=1;" vertex="1" parent="vision"><mxGeometry x="105" y="330" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="zero" value="zero_order&#xa;零级中心区域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E8;strokeColor=#00A67E;fontStyle=1;strokeWidth=2;shadow=1;" vertex="1" parent="vision"><mxGeometry x="485" y="330" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="guide" value="提取近场条纹路标&#xa;多帧连续性约束&#xa;优先选择最接近画面中心的目标" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#4D86C6;strokeWidth=1.5;" vertex="1" parent="vision"><mxGeometry x="65" y="455" width="245" height="90" as="geometry"/></mxCell>
        <mxCell id="motion" value="条纹运动趋势判断&#xa;左移 / 右移 / 稳定&#xa;短时丢失保持" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#4D86C6;strokeWidth=1.5;" vertex="1" parent="vision"><mxGeometry x="330" y="455" width="205" height="90" as="geometry"/></mxCell>
        <mxCell id="center_roi" value="零级区域扩大 ROI&#xa;保留检测位置先验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F5EC;strokeColor=#00A67E;strokeWidth=1.5;" vertex="1" parent="vision"><mxGeometry x="555" y="455" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="algorithm" value="中心条纹精定位&#xa;RGB 局部条纹能量&#xa;包络对称性 + 边缘对&#xa;零级区域边界约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8F7;strokeColor=#76539B;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="vision"><mxGeometry x="535" y="565" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="tracker" value="多帧中心跟踪&#xa;中值平滑 / 跳变抑制&#xa;检测漏帧短时保持" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4F5EC;strokeColor=#00A67E;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="vision"><mxGeometry x="535" y="715" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="search" value="中心搜索与闭环寻中&#xa;双向扩展搜索 或&#xa;已知方向单向找条纹&#xa;找到后允许反向校正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0DF;strokeColor=#D78320;fontStyle=1;strokeWidth=2;shadow=1;" vertex="1" parent="vision"><mxGeometry x="175" y="690" width="250" height="115" as="geometry"/></mxCell>

        <mxCell id="motor" value="安全电机命令队列&#xa;调速 / 正转 / 反转 / 停车" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="out"><mxGeometry x="75" y="75" width="240" height="75" as="geometry"/></mxCell>
        <mxCell id="centered" value="中心进入容差并&#xa;连续多帧稳定？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="out"><mxGeometry x="95" y="195" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="stop" value="可靠停车&#xa;保存中心位置" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="out"><mxGeometry x="115" y="335" width="160" height="65" as="geometry"/></mxCell>
        <mxCell id="meter_capture" value="微分表相机独占采集&#xa;有效区域自动搜索" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="out"><mxGeometry x="30" y="445" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="ocr" value="微分表 OCR 识别&#xa;数字识别 + 小数点归一化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFE8F7;strokeColor=#76539B;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="out"><mxGeometry x="215" y="445" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="stable" value="读数稳定器&#xa;重复帧确认 + 采集时间戳" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="out"><mxGeometry x="105" y="555" width="180" height="70" as="geometry"/></mxCell>
        <mxCell id="output" value="实时输出与记录&#xa;标注画面 / 中心 x / 置信度&#xa;条纹运动 / 微分表读数 / 时间戳" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#00A67E;fontStyle=1;strokeWidth=2;" vertex="1" parent="out"><mxGeometry x="65" y="675" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="assistant" value="实验助手实时状态与进度&#xa;现场判断 → 下一步 → 完成标志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEAFF;strokeColor=#1677FF;fontStyle=1;" vertex="1" parent="out"><mxGeometry x="75" y="800" width="240" height="65" as="geometry"/></mxCell>

